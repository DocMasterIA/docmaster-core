# Copie para fora do git, ex.:
#   mkdir -p ~/docmaster-backups
#   cp config/backup-r2.env.example ~/docmaster-backups/backup-r2.env
#   chmod 600 ~/docmaster-backups/backup-r2.env
#
# Nunca commite secrets. Use:
#   export BACKUP_R2_ENV=~/docmaster-backups/backup-r2.env

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=docmaster-backups
# Se vazio, usa https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# Remote rclone (criado por setup-rclone-r2.sh)
RCLONE_REMOTE=docmaster_r2

# Prefixo dentro do bucket
R2_PREFIX=docmaster

# rolling = atualiza sempre a mesma pasta current/ (recomendado — NÃO empilha GB)
# versioned = cria pasta datada por corrida (só se quiseres histórico explícito)
BACKUP_MODE=rolling
BACKUP_REMOTE_SLOT=current
BACKUP_PURGE_OLD_STAMPS=1
# auto = users/media todo dia; PNCP/platforms/crosslink só se o ficheiro no Docker mudou de tamanho
# critical | indexes | full
BACKUP_PROFILE=auto
# Cópias antigas do db.sqlite3 em history/backend/ (~15MB cada) — recuperar users
BACKUP_BACKEND_HISTORY_KEEP=14

# --- Volumes Docker (ajuste aos nomes REAIS: docker volume ls | grep -E 'backend|pncp|price') ---
# Produção discutida: docmaster_backend_data (evitar *-core_* vazio)
VOL_BACKEND_DATA=docmaster_backend_data
VOL_BACKEND_MEDIA=docmaster_backend_media
VOL_PNCP_DATA=docmaster_pncp_researcher_data
VOL_PRICE_PLATFORM=docmaster-pncp_price_platform_data
VOL_PRICE_CROSSLINK=docmaster-pncp_price_crosslink_data

# Ligar/desligar componentes (1/0)
BACKUP_BACKEND_DB=1
BACKUP_BACKEND_MEDIA=1
BACKUP_PNCP_DB=1
BACKUP_PLATFORM_DBS=1
BACKUP_CROSSLINK_DB=1

# --- Staging / retenção ---
BACKUP_ROOT="${HOME}/docmaster-backups"
# Só usado se BACKUP_MODE=versioned
BACKUP_KEEP_REMOTE=2
BACKUP_KEEP_LOCAL_STAGING=1

# Imagem para sqlite .backup e tar (precisa python3)
BACKUP_TOOL_IMAGE=python:3.12-slim-bookworm
