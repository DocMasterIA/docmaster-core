# Observabilidade em api.docmasteria.com.br (nginx no host da VPS).
# Prometheus: https://api.docmasteria.com.br/prometheus/
# Grafana:    https://api.docmasteria.com.br/grafana/
#
# Pré-requisitos (compose na pasta DEPLOY):
#   - Prometheus com --web.route-prefix=/prometheus (ver docker-compose.yml)
#   - Grafana com GF_SERVER_ROOT_URL e GF_SERVER_SERVE_FROM_SUB_PATH
#   - Portas 9090 e 3000 só em 127.0.0.1 (não expor IP:3000 / IP:9090 na internet)
#
# Inclua este bloco no server { } de api.docmasteria.com.br, ANTES do location / do Django.

location /prometheus/ {
    proxy_pass http://127.0.0.1:9090;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}

location /grafana/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}

# Opcional: restringir por IP (Tailscale / escritório)
# location /prometheus/ { allow 100.64.0.0/10; deny all; ... }
# location /grafana/    { allow 100.64.0.0/10; deny all; ... }
