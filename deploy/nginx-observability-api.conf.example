# OPCIONAL — NÃO é necessário para usar Grafana no dia a dia.
#
# O projeto usa por padrão: http://127.0.0.1:3000 na VPS + túnel SSH do PC.
# Sem este ficheiro, api.docmasteria.com.br/grafana dá 404 (Django) — isso é esperado.
#
# Só aplique se souber exatamente onde o nginx do servidor define api.docmasteria.com.br
# (não há "sites-enabled" obrigatório; cada servidor é diferente).
# Teste sempre: sudo nginx -t && sudo systemctl reload nginx
#
# Se usar este bloco, no .env do DEPLOY também defina:
#   PROMETHEUS_ROUTE_PREFIX=/prometheus
#   PROMETHEUS_EXTERNAL_URL=https://api.docmasteria.com.br/prometheus/
#   GRAFANA_ROOT_URL=https://api.docmasteria.com.br/grafana/
#   GRAFANA_SERVE_FROM_SUB_PATH=true
#
# Inclua ANTES do location / do Django.

location /prometheus/ {
    proxy_pass http://127.0.0.1:9090;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}

location /grafana/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}

# Opcional: restringir por IP (Tailscale / escritório)
# location /prometheus/ { allow 100.64.0.0/10; deny all; ... }
# location /grafana/    { allow 100.64.0.0/10; deny all; ... }
